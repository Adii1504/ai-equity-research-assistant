# ── Required ──────────────────────────────────────────────────────────────────
# Get free key from: console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Get free key from: newsapi.org (100 req/day)
# If not set, yfinance news feed is used as primary source
NEWS_API_KEY=your_newsapi_key_here

# ── Redis (leave as-is for local Docker setup) ────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# — Database (Optional — required for login/signup and personalised recommendations) ——
# Local Docker: docker run --name financecla-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
# Or use: docker compose -f docker-compose.web.yml up postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financecla

# — Auth —————————————————————————————————————————————————————————————
# Any long random string works. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_here
