# ── Required ──────────────────────────────────────────────────────────────────
# Get free key from: console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Get free key from: newsapi.org (100 req/day)
# If not set, yfinance news feed is used as primary source
NEWS_API_KEY=your_newsapi_key_here

# ── Redis (leave as-is for local Docker setup) ────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
